{
  "name": "ng-openapi-signals",
  "version": "0.10.0",
  "description": "Signal-first OpenAPI client generator for Angular using resource() and fetch().",
  "type": "module",
  "bin": {
    "ng-openapi-signals": "./dist/cli.mjs"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "test": "vitest",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:example": "npm run build && node dist/cli.mjs generate --config examples/ng-openapi-signals.config.ts",
    "check:example": "npm run build && node dist/cli.mjs generate --config examples/ng-openapi-signals.config.ts --check",
    "check:publint": "publint",
    "check:attw": "attw --pack",
    "check:knip": "knip",
    "check:release": "npm run check:publint && npm run check:attw && npm run check:knip"
  },
  "keywords": [
    "angular",
    "angular-22",
    "openapi",
    "swagger",
    "signals",
    "resource",
    "fetch",
    "codegen",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ynnckrkn/ng-openapi-signals.git"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "knip": "^6.32.2",
    "publint": "^0.3.23",
    "tsdown": "^0.22.5",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
